# 文本统一 LF，避免 Windows 下换行符反复变更
* text=auto eol=lf

# 媒体资源按二进制处理：不做换行转换、不做 diff
*.mp3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# 明确按文本处理
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.lrc  text eol=lf
*.txt  text eol=lf
